# Local development uses the diagram-webkit checkout when it is there: engine
# edits hot-reload in `npm run dev`, and the CLI (`npm run validate`) runs from
# it. CI has no direnv and uses the installed package. One command against the
# installed package: DIAGRAM_WEBKIT_DIR= npm run dev
diagram_webkit="$HOME/base/diagram-webkit/repo"
if [ -z "${DIAGRAM_WEBKIT_DIR+x}" ] && [ -d "$diagram_webkit" ]; then
  export DIAGRAM_WEBKIT_DIR="$diagram_webkit"
fi
